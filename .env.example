# OpenAI-compatible endpoint. Use your provider's current tool-capable model.
# Local example: Ollama; download the model separately before running Relay.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-not-a-secret
LLM_MODEL=qwen3:8b
TOOL_MODE=native

# Hosted alternative: replace the endpoint/model/key with your provider's values.
# Do not commit .env. Hosted providers receive ticket text and tool observations
# and may charge per token. All bundled business data is fictional.
# TOOL_MODE=json can be used for models without native function calling.

# Optional deterministic connector fault injection:
# CHAOS_SEED=42
